<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Amazon Product Search Suite" verbose="2">
    <listeners>
        <listener class-name="com.krce.amazon.utilities.ExtentTestNGListener"/>
    </listeners>
    <test name="Amazon Product Search Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.krce.amazon.tests.AmazonProductSearchTest"/>
        </classes>
    </test>
</suite>
